# backup (B) drive backup script.
# requires environment varialbe BACKUP_HOME set to the backup home directory,
# append syncing occurs from $HOME/Backup to $BACKUP_HOME

[ -z "${BACKUP_HOME}" ] && echo 'required environment variable (BACKUP_HOME) is undefined, exiting...' && exit 4;

[ "$(mount | grep -c "$BACKUP_HOME")" = 0 ] && echo "no drive mounted at $BACKUP_HOME, exiting..." && exit 5;

BK_SRC="$HOME/Backup";
BK_DEST="$BACKUP_HOME";
BK_TYPE=$(basename "$0");
echo "starting $BK_TYPE: $BK_SRC -> $BK_DEST...";

echo 'generic backup...';
sudo rsync -avxP "$BK_SRC" "$BK_DEST"; # appends, no deletions / mirroring

echo 'update record...';
date +'%Y-%m-%d_%r' | sed s/\ //g >> "$BK_DEST/$BK_TYPE.txt";

echo 'script complete';
notify-say "$BK_TYPE" 'backup done';

